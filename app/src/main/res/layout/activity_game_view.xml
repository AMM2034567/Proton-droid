<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 内嵌 X 服务器（libXlorie）渲染视图：X 画面由 EGL 直接合成到本 Surface -->
    <com.termux.x11.LorieView
        android:id="@+id/surface_game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部半透明浮动控制条 (包含退出/暂停按钮) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#80000000"
        android:padding="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_game_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="10dp"
            android:text="Windows Game"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_exit_game"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="退出游戏"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 运行状态/错误提示条：启动失败时把根因直接显示出来，避免“黑屏无反应” -->
    <TextView
        android:id="@+id/tv_game_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:fontFamily="monospace"
        android:maxLines="8"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:text="[准备启动] 正在初始化 Proton 运行时..."
        android:textColor="@color/accent_green"
        android:textSize="11sp" />

</FrameLayout>
