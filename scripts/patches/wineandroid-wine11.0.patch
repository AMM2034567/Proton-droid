  */
 BOOL ANDROID_CreateDesktop( const WCHAR *name, UINT width, UINT height )
 {
+    /* 真机实测：win32u 会先调 pCreateDesktop、之后才建桌面窗口，
+     * 于是 ANDROID_CreateWindow 里的初始化永远等不到 ⇒ desktop_tid/screen_width 恒为 0 ⇒ 死等。
+     * 这里先把事件队列与设备线程（Java 侧桌面视图的建立者）拉起来。 */
+    if (!desktop_tid)
+    {
+        init_event_queue();
+        start_android_device();
+    }
+
     /* wait until we receive the surface changed event */
     while (!screen_width)
     {
@@ -1250,5 +1281,7 @@ BOOL ANDROID_CreateDesktop( const WCHAR *name, UINT width, UINT height )
         }
         process_events( QS_ALLINPUT );
     }
-    return 0;
+    /* BOOL 函数：必须返回 TRUE。上游写成 return 0 ⇒ win32u 认为建桌面失败，
+     * explorer 报 "manage_desktop failed to create desktop"，随后一路 nodrv_CreateWindow。 */
+    return TRUE;
 }
