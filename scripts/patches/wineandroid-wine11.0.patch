diff --git a/dlls/wineandroid.drv/init.c b/dlls/wineandroid.drv/init.c
--- a/dlls/wineandroid.drv/init.c
+++ b/dlls/wineandroid.drv/init.c
@@ -525,7 +525,18 @@ static HRESULT android_init( void *arg )
     JavaVM *java_vm;
     void *ntdll;
 
-    if (!(ntdll = dlopen( "ntdll.so", RTLD_NOW ))) return STATUS_UNSUCCESSFUL;
+    if (!(ntdll = dlopen( "ntdll.so", RTLD_NOW )))
+    {
+        ERR( "wineandroid: dlopen(ntdll.so) failed: %s\n", dlerror() );
+        /* Android：按名字 dlopen 依赖 LD_LIBRARY_PATH 的运行时更新（android_update_LD_LIBRARY_PATH），
+           现代 Android 上拿不到该符号 ⇒ 退回全局命名空间查符号（Java 侧已用 RTLD_GLOBAL 预加载）。 */
+        if (!dlsym( RTLD_DEFAULT, "java_vm" ))
+        {
+            ERR( "wineandroid: java_vm not found in RTLD_DEFAULT either\n" );
+            return STATUS_UNSUCCESSFUL;
+        }
+        ntdll = RTLD_DEFAULT;
+    }
 
     p_java_vm = dlsym( ntdll, "java_vm" );
     p_java_object = dlsym( ntdll, "java_object" );
@@ -537,7 +548,6 @@ static HRESULT android_init( void *arg )
 
     pthread_mutexattr_init( &attr );
     pthread_mutexattr_settype( &attr, PTHREAD_MUTEX_RECURSIVE );
-    pthread_mutex_init( &drawable_mutex, &attr );
