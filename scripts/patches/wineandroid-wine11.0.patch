+void ANDROID_InitDevice(void)
+{
+    if (desktop_tid) return;   /* 幂等 */
+    /* 设备线程 + Java 桌面视图要尽早起来：这样 Java 报来的屏幕尺寸能在主程序建窗之前
+     * 被 init_monitors() 采用。否则窗口会以 0 尺寸建出来（真机实测：窗口高度 0、屏幕全黑）。 */
+    init_event_queue();
+    start_android_device();
+}
